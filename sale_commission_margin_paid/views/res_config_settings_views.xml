<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_commission" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.commission.margin.paid</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Commission Accounting"
                     name="sale_commission_margin_paid"
                     groups="account.group_account_manager">
                    <block title="Commission Accounting Accounts"
                           id="commission_accounting_block">
                        <setting string="Commission Expense Account"
                                 help="Debited when a commission is accrued, right after the source invoice is posted.">
                            <field name="commission_expense_account_id"/>
                        </setting>
                        <setting string="Commission Accrual Account"
                                 help="Liability account holding commissions earned but not yet payable.">
                            <field name="commission_accrual_account_id"/>
                        </setting>
                        <setting string="Salesperson Payable Account"
                                 help="Credited once the source invoice is fully paid, representing the amount owed to the salesperson.">
                            <field name="commission_payable_account_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
